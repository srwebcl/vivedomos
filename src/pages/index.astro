---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import DomoCard from "../components/DomoCard.astro";
import ContactForm from "../components/ContactForm.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import Gallery from "../components/Gallery.astro";
import Marquee from "../components/Marquee.astro";

// Importar imágenes para optimización automática
import imgDomo8m from '../assets/images/hero-domo-1.jpeg';
import imgDomo10m from '../assets/images/hero-domo-2.jpeg';
---

<Layout>
    <Header />
    <Hero />
    <Marquee />

    <!-- Sección de domos -->
    <section id="domos" class="container" style="padding: 6rem 0;">
        <div class="section-header" style="text-align: center; margin-bottom: 4rem;">
            <span class="pre-title" style="color: var(--secondary); font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.9rem; display: block; margin-bottom: 0.5rem;">Modelos Exclusivos</span>
            <h2 style="font-size: clamp(2rem, 4vw, 3rem); margin-bottom: 1rem; color: var(--primary-dark);">Nuestros Domos Llave en Mano</h2>
            <div style="width: 60px; height: 3px; background-color: var(--secondary); margin: 0 auto;"></div>
        </div>
        <div class="grid">
            <DomoCard
                titulo="Domo Geodésico 8 m"
                precio="$16.990.000"
                area="64 m²"
                habitaciones="2 niveles · 1 baño · Cocina americana"
                link="/domo-8m"
                imagen={imgDomo8m}
            />
            <DomoCard
                titulo="Domo Geodésico 10 m"
                precio="$22.490.000"
                area="112 m²"
                habitaciones="2 niveles · 1 baño · Amplio espacio"
                link="/domo-10m"
                imagen={imgDomo10m}
            />
        </div>
    </section>

    <!-- Beneficios -->
    <section id="beneficios" style="background: var(--light); padding: 6rem 0;">
        <div class="container">
            <div class="section-header animate-on-scroll" style="text-align: center; margin-bottom: 4rem;">
                <span class="pre-title" style="color: var(--secondary); font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.9rem; display: block; margin-bottom: 0.5rem;">Nuestra Propuesta de Valor</span>
                <h2 style="font-size: clamp(2rem, 4vw, 3rem); margin-bottom: 1rem; color: var(--primary-dark);">¿Por qué elegir VIVE DOMOS?</h2>
                <div style="width: 60px; height: 3px; background-color: var(--secondary); margin: 0 auto;"></div>
            </div>
            
            <div class="features-grid">
                <div class="feature-card animate-on-scroll">
                    <div class="icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--secondary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                    </div>
                    <h3>Eficiencia energética</h3>
                    <p>Excelente aislamiento térmico y ventilación natural que reduce significativamente los costos de climatización durante todo el año.</p>
                </div>
                <div class="feature-card animate-on-scroll" style="transition-delay: 0.1s;">
                    <div class="icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--secondary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
                    </div>
                    <h3>Resistencia estructural</h3>
                    <p>Nuestra geometría geodésica perfecta soporta vientos extremos, lluvia intensa y gran acumulación de nieve sin comprometer la estructura.</p>
                </div>
                <div class="feature-card animate-on-scroll" style="transition-delay: 0.2s;">
                    <div class="icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--secondary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                    </div>
                    <h3>Instalación rápida</h3>
                    <p>Contamos con un sistema constructivo optimizado que nos permite entregar tu proyecto "Llave en mano" en tiempos récord frente a la construcción tradicional.</p>
                </div>
                <div class="feature-card animate-on-scroll" style="transition-delay: 0.3s;">
                    <div class="icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--secondary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                    </div>
                    <h3>Versatilidad total</h3>
                    <p>Ideal como vivienda definitiva, proyecto de glamping turístico premium, lodge comercial, centro de terapias o estudio creativo de alto nivel.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Galería -->
    <Gallery />

    <style>
        .feature-card {
            background: var(--white);
            padding: 3rem 2rem;
            border-radius: 1.5rem;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
            text-align: center;
            transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94), box-shadow 0.4s ease;
            border: 1px solid rgba(0,0,0,0.03);
            border-top: 4px solid transparent;
            position: relative;
            overflow: hidden;
        }

        .feature-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: var(--secondary);
            transform: scaleX(0);
            transition: transform 0.4s ease;
            transform-origin: left;
        }

        .feature-card:hover::before {
            transform: scaleX(1);
        }

        .feature-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
        }

        .feature-card .icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 2rem;
            background: rgba(221, 161, 94, 0.1); /* light secondary */
            width: 80px;
            height: 80px;
            border-radius: 50%;
            transition: transform 0.4s ease, background 0.4s ease;
        }

        .feature-card:hover .icon {
            transform: scale(1.1);
            background: rgba(221, 161, 94, 0.2);
        }

        .feature-card h3 {
            font-size: 1.35rem;
            margin-bottom: 1.2rem;
            color: var(--primary-dark);
            font-weight: 700;
        }

        .feature-card p {
            color: var(--gray);
            font-size: 1rem;
            line-height: 1.6;
        }

        .features-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 2rem;
        }

        @media (min-width: 640px) {
            .features-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (min-width: 992px) {
            .features-grid {
                grid-template-columns: repeat(4, 1fr);
            }
        }
    </style>

    <!-- Cotización y contacto -->
    <section id="contacto" class="container" style="padding: 6rem 0;">
        <div class="section-header animate-on-scroll" style="text-align: center; margin-bottom: 4rem;">
            <span class="pre-title" style="color: var(--secondary); font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.9rem; display: block; margin-bottom: 0.5rem;">Da el primer paso</span>
            <h2 style="font-size: clamp(2rem, 4vw, 3rem); margin-bottom: 1rem; color: var(--primary-dark);">Solicita tu cotización</h2>
            <div style="width: 60px; height: 3px; background-color: var(--secondary); margin: 0 auto 1.5rem auto;"></div>
            <p style="color: var(--gray); font-size: 1.1rem; max-width: 600px; margin: 0 auto;">Cuéntanos sobre tu proyecto y nuestro equipo de especialistas se contactará contigo a la brevedad para asesorarte.</p>
        </div>
        <div style="max-width: 700px; margin: 0 auto;">
            <ContactForm />
        </div>
    </section>

    <WhatsAppButton />

    <footer class="footer">
        <div class="container footer-content">
            <div class="footer-info">
                <p class="copyright">© <span id="current-year"></span> VIVE DOMOS - Todos los derechos reservados.</p>
                <p class="despacho">Despacho e instalación en todo Chile.</p>
                <p class="whatsapp">WhatsApp: <a href="https://wa.me/56974288861" style="color: inherit; text-decoration: none; font-weight: 600;">+56 9 7428 8861</a></p>
            </div>
            <div class="footer-credits">
                <p>Desarrollado con <span class="rayo">⚡</span> por <a href="https://www.srweb.cl" target="_blank" rel="noopener noreferrer" class="srweb-link">SRweb</a></p>
            </div>
        </div>
    </footer>

    <style>
        .footer {
            background: rgba(18, 43, 39, 1); /* var(--dark) */
            color: rgba(255, 255, 255, 0.8);
            padding: 3rem 0;
            margin-top: 4rem;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
        }

        .footer-content {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 1.5rem;
            text-align: center;
        }

        @media (min-width: 768px) {
            .footer-content {
                flex-direction: row;
                justify-content: space-between;
                text-align: left;
            }
        }

        .footer-info p {
            margin-bottom: 0.25rem;
            font-size: 0.95rem;
        }

        .footer-credits p {
            font-size: 0.95rem;
            color: rgba(255, 255, 255, 0.6);
        }

        .rayo {
            color: #FFD700;
        }

        .srweb-link {
            color: var(--secondary);
            text-decoration: none;
            font-weight: 600;
            transition: color 0.3s ease;
        }

        .srweb-link:hover {
            color: var(--white);
        }
    </style>

    <script>
        // Actualizar año automáticamente
        const yearEl = document.getElementById('current-year');
        if (yearEl) {
            yearEl.textContent = new Date().getFullYear().toString();
        }
    </script>
</Layout>
