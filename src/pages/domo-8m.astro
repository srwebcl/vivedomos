---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { Image } from 'astro:assets';
import heroImg from '../assets/images/hero-domo-1.jpeg';
import interiorImg1 from '../assets/images/interior-domo-8.jpeg';
import interiorImg2 from '../assets/images/interior-domo.jpeg';
import p1 from '../assets/images/proyecto-domo-1.jpeg';
import p2 from '../assets/images/proyecto-domo-2.jpeg';
---

<Layout title="Domo Geodésico de 8 Metros | Vive Domos" description="Descubre nuestro exclusivo Domo Geodésico de 8 metros. Perfecto para proyectos de glamping o cabañas turísticas. Construcción llave en mano en todo Chile.">
    <Header />
    <div class="page-hero animate-on-scroll" style={`--hero-bg: url('${heroImg.src}')`}>
        <div class="container">
            <span class="pre-title">Línea Exclusiva</span>
            <h1>Domo Geodésico 8 m</h1>
            <div class="title-separator"></div>
            <p class="subtitle">64 m² – Diseño y Confort Llave en Mano</p>
        </div>
    </div>

    <article class="container">
        <div class="content-grid">
            <div class="main-content animate-on-scroll">
                <Image src={heroImg} alt="Domo Geodésico 8m" class="featured-image" width={1000} height={600} loading="eager" />
                
                <p class="lead-text">
                    Domo geodésico de 64 m² con dos niveles, baño completo,
                    cocina americana equipada y amplios espacios iluminados
                    naturalmente. Ideal para vivienda, glamping, alojamiento
                    turístico o estudio creativo.
                </p>

                <div class="image-gallery">
                    <Image src={interiorImg1} alt="Interior Domo 8m" class="gallery-img" width={600} height={400} loading="lazy" />
                    <Image src={interiorImg2} alt="Interior Domo 8m detalle" class="gallery-img" width={600} height={400} loading="lazy" />
                    <Image src={p1} alt="Domo 8m en terreno" class="gallery-img" width={600} height={400} loading="lazy" />
                    <Image src={p2} alt="Vista exterior Domo 8m" class="gallery-img" width={600} height={400} loading="lazy" />
                </div>

                <h2>Diseñado para una vida distinta</h2>
                <p>
                    El Domo Geodésico de 8 metros combina diseño, eficiencia
                    energética y confort en un espacio único. Su estructura
                    geodésica ofrece gran resistencia y un excelente
                    comportamiento térmico, aprovechando al máximo cada metro
                    cuadrado disponible.
                </p>

                <div class="specs-grid">
                    <div class="spec-box">
                        <h3>Construcción y Materiales</h3>
                        <ul class="styled-list">
                            <li>Base de polines impregnados.</li>
                            <li>Fundaciones con pilotes de hormigón H20.</li>
                            <li>Estructura de piso en pino 3x2 con vigas 2x4.</li>
                            <li>Terciado estructural de 18 mm.</li>
                            <li>Estructura geodésica en pino 1x4.</li>
                            <li>Revestimiento exterior con OSB de 9,5 mm, fieltro y teja asfáltica.</li>
                        </ul>
                    </div>
                    <div class="spec-box">
                        <h3>Distribución Interior</h3>
                        <ul class="styled-list">
                            <li>Dos niveles.</li>
                            <li>Un baño completo.</li>
                            <li>Piso flotante en áreas habitables.</li>
                            <li>Cerámica en baño.</li>
                            <li>Cocina americana equipada.</li>
                            <li>16 ventanas abatibles con vidrio de 6 mm.</li>
                        </ul>
                    </div>
                </div>
            </div>

            <aside class="sidebar animate-on-scroll">
                <div class="sticky-card">
                    <span class="price-label">Valor desde</span>
                    <div class="price">$16.990.000</div>
                    <p class="price-note">Proyecto 100% llave en mano</p>
                    
                    <div class="benefits-container">
                        <ul class="benefits-list">
                            <li>
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--secondary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                                <span>Ideal para glamping y turismo</span>
                            </li>
                            <li>
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--secondary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                                <span>Excelente eficiencia térmica</span>
                            </li>
                            <li>
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--secondary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                                <span>Diseño moderno y atractivo</span>
                            </li>
                            <li>
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--secondary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                                <span>Instalación rápida en terreno</span>
                            </li>
                        </ul>
                    </div>

                    <div class="trust-badge-small">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                        <span>Garantía estructural de fábrica</span>
                    </div>

                    <hr class="divider" />
                    
                    <a href="https://wa.me/56912345678?text=Hola%2C%20quiero%20cotizar%20el%20domo%20de%208m" class="btn" style="width: 100%; text-align: center; padding: 1rem; font-size: 1.1rem;">
                        Solicitar cotización
                    </a>
                    <p class="delivery-info">🚚 Despacho e instalación en todo Chile</p>
                </div>
            </aside>
        </div>
    </article>

    <style>
        .page-hero {
            background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary) 100%);
            color: var(--white);
            padding: 8rem 0 4rem 0; /* Extra top padding for fixed header */
            text-align: center;
            margin-bottom: 4rem;
            position: relative;
            overflow: hidden;
            border-radius: 0 0 2rem 2rem;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }
        
        .page-hero::before {
            content: '';
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: var(--hero-bg) center/cover no-repeat;
            opacity: 0.15;
            mix-blend-mode: overlay;
        }

        .page-hero .container {
            position: relative;
            z-index: 2;
        }

        .pre-title {
            color: var(--secondary);
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            font-size: 0.9rem;
            display: block;
            margin-bottom: 1rem;
        }

        .page-hero h1 {
            color: var(--white);
            margin-bottom: 1rem;
            font-size: clamp(2.5rem, 5vw, 4rem);
            text-shadow: 0 2px 10px rgba(0,0,0,0.3);
        }

        .title-separator {
            width: 60px;
            height: 3px;
            background-color: var(--secondary);
            margin: 0 auto 1.5rem auto;
        }

        .subtitle {
            color: rgba(255, 255, 255, 0.9);
            font-size: 1.25rem;
            font-weight: 400;
            letter-spacing: 0.02em;
        }

        .content-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 4rem;
            padding-bottom: 5rem;
        }

        @media (min-width: 992px) {
            .content-grid {
                grid-template-columns: 1.8fr 1fr;
            }
        }

        .featured-image {
            width: 100%;
            border-radius: 1.5rem;
            margin-bottom: 3rem;
            box-shadow: var(--shadow-xl);
            object-fit: cover;
            max-height: 550px;
        }

        .image-gallery {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
            margin: 3rem 0;
        }

        .gallery-img {
            width: 100%;
            border-radius: 1rem;
            box-shadow: var(--shadow-md);
            object-fit: cover;
            aspect-ratio: 4/3;
            transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }

        .gallery-img:hover {
            transform: scale(1.05);
            box-shadow: var(--shadow-lg);
        }

        .lead-text {
            font-size: 1.3rem;
            color: var(--primary-dark);
            font-weight: 400;
            margin-bottom: 3rem;
            line-height: 1.8;
        }

        .specs-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 2rem;
            margin-top: 3rem;
        }

        .spec-box {
            background: var(--white);
            padding: 2.5rem;
            border-radius: 1.5rem;
            border: 1px solid rgba(0,0,0,0.03);
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
            transition: transform 0.3s ease;
        }

        .spec-box:hover {
            transform: translateY(-5px);
        }

        .spec-box h3 {
            color: var(--primary-dark);
            border-bottom: 3px solid var(--secondary);
            padding-bottom: 0.75rem;
            margin-bottom: 1.5rem;
            display: inline-block;
        }

        .styled-list {
            list-style: none;
            padding-left: 0;
        }

        .styled-list li {
            position: relative;
            padding-left: 1.75rem;
            margin-bottom: 1rem;
            color: var(--gray);
            line-height: 1.5;
        }

        .styled-list li::before {
            content: '✓';
            color: var(--secondary);
            font-weight: 700;
            font-size: 1rem;
            position: absolute;
            left: 0;
            top: 2px;
        }

        .sticky-card {
            background: var(--white);
            padding: 2.5rem;
            border-radius: 1.5rem;
            box-shadow: 0 15px 40px rgba(0,0,0,0.08);
            border: 1px solid rgba(0,0,0,0.04);
            position: sticky;
            top: 120px;
        }

        .price-label {
            font-size: 0.9rem;
            color: var(--gray);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            font-weight: 600;
            display: block;
            margin-bottom: 0.5rem;
        }

        .price {
            font-size: 3.5rem;
            font-weight: 700;
            color: var(--secondary);
            line-height: 1;
            margin-bottom: 0.5rem;
            font-family: var(--font-heading);
        }

        .price-note {
            color: var(--gray);
            font-size: 1rem;
            margin-bottom: 2.5rem;
            padding-bottom: 1.5rem;
            border-bottom: 1px solid var(--gray-light);
        }

        .benefits-list {
            list-style: none;
            padding-left: 0;
            margin-bottom: 2rem;
        }

        .benefits-list li {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1rem;
            color: var(--primary-dark);
            font-weight: 500;
        }

        .trust-badge-small {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            margin-bottom: 1.5rem;
            color: var(--primary-light);
            background: rgba(30, 69, 62, 0.05);
            padding: 0.75rem;
            border-radius: 0.5rem;
            font-size: 0.85rem;
            font-weight: 600;
        }

        .divider {
            border: 0;
            height: 1px;
            background: var(--gray-light);
            margin: 1.5rem 0;
        }

        .delivery-info {
            text-align: center;
            margin-top: 1.5rem;
            color: var(--gray);
            font-size: 0.95rem;
            font-weight: 500;
        }

        /* Optimizaciones para Móviles */
        @media (max-width: 768px) {
            .page-hero {
                padding: 6.5rem 1rem 3rem 1rem; /* Menos padding superior */
                border-radius: 0 0 1.5rem 1.5rem;
                margin-bottom: 2.5rem;
            }

            .content-grid {
                gap: 2rem;
                padding-bottom: 3rem;
            }

            .featured-image {
                margin-bottom: 1.5rem;
                border-radius: 1rem;
                max-height: 350px;
            }

            .lead-text {
                font-size: 1.15rem;
                margin-bottom: 2rem;
            }

            .image-gallery {
                grid-template-columns: 1fr; /* Una columna en móvil para que las fotos se vean grandes */
                gap: 1rem;
                margin: 2rem 0;
            }

            .specs-grid {
                gap: 1.5rem;
                margin-top: 2rem;
            }

            .spec-box {
                padding: 1.5rem;
            }

            .sticky-card {
                padding: 2rem 1.5rem;
            }

            .price {
                font-size: 3rem;
            }
        }
    </style>
    <WhatsAppButton />
</Layout>
