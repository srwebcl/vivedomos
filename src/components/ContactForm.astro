<form
    id="contact-form"
    class="premium-form animate-on-scroll"
>
    <!-- Honeypot Field (Anti-Bot) -->
    <input type="text" name="_gotcha" style="display:none !important" tabindex="-1" autocomplete="off" />

    <div class="form-group">
        <label for="name">Nombre completo</label>
        <input type="text" id="name" name="name" required placeholder="Ej: Juan Pérez" />
    </div>
    <div class="form-group">
        <label for="email">Correo electrónico</label>
        <input type="email" id="email" name="email" required placeholder="ejemplo@correo.com" />
    </div>
    <div class="form-group">
        <label for="phone">Teléfono</label>
        <input type="tel" id="phone" name="phone" placeholder="+56 9 7428 8861" />
    </div>
    <div class="form-group">
        <label for="message">Mensaje</label>
        <textarea id="message" name="message" rows="4" required placeholder="Me gustaría cotizar el domo de 8m..."></textarea>
    </div>
    <div class="trust-badge">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
        <span>Tus datos están 100% seguros y nunca serán compartidos.</span>
    </div>
    
    <button type="submit" class="btn" style="width: 100%; font-size: 1.1rem; padding: 1rem;">Quiero mi cotización gratuita</button>
    
    <p class="form-footer">
        Respuesta rápida garantizada en menos de 24 horas ⏱️
    </p>


</form>

<style>
    .premium-form {
        background: var(--white);
        padding: 3rem;
        border-radius: 1.5rem;
        box-shadow: var(--shadow-xl);
        border: 1px solid rgba(0,0,0,0.05);
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-group label {
        display: block;
        font-weight: 600;
        margin-bottom: 0.5rem;
        color: var(--primary-dark);
        font-size: 0.95rem;
    }

    .form-group input,
    .form-group textarea {
        width: 100%;
        padding: 1rem 1.25rem;
        border: 1px solid var(--gray-light);
        border-radius: 0.75rem;
        font-family: var(--font-body);
        font-size: 1rem;
        transition: all 0.3s ease;
        background-color: #fafafa;
    }

    .form-group input:focus,
    .form-group textarea:focus {
        outline: none;
        border-color: var(--primary);
        background-color: var(--white);
        box-shadow: 0 0 0 3px rgba(30, 69, 62, 0.1);
    }

    .form-group input::placeholder,
    .form-group textarea::placeholder {
        color: #9ca3af;
    }

    .form-footer {
        font-size: 0.875rem;
        margin-top: 1.5rem;
        color: var(--gray);
        text-align: center;
    }

    .trust-badge {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
        color: var(--primary-light);
        background: rgba(30, 69, 62, 0.05);
        padding: 0.75rem;
        border-radius: 0.5rem;
        font-size: 0.85rem;
        font-weight: 500;
    }

    .recaptcha-text {
        font-size: 0.7rem;
        color: #9ca3af;
        text-align: center;
        margin-top: 1rem;
        line-height: 1.4;
    }

    .recaptcha-text a {
        color: #6b7280;
        text-decoration: underline;
    }
</style>

<style is:global>
    .grecaptcha-badge { 
        visibility: hidden !important; 
    }
</style>

<!-- Google reCAPTCHA v3 Script -->
<script src="https://www.google.com/recaptcha/api.js?render=6LeE_RMtAAAAACe9qqdTi2iYcenZQEnH0-v5DZfk" async defer></script>

<script>
    declare const grecaptcha: any;
    
    const form = document.getElementById("contact-form") as HTMLFormElement;
    if (form) {
        form.addEventListener("submit", async (e) => {
            e.preventDefault();
            
            const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
            const originalBtnText = submitBtn.textContent || "Quiero mi cotización gratuita";
            submitBtn.textContent = "Enviando cotización...";
            submitBtn.disabled = true;
            submitBtn.style.opacity = "0.7";

            try {
                const formData = new FormData(form);

                // Simulate reCAPTCHA v3 Execution
                if (typeof grecaptcha !== "undefined") {
                    try {
                        const token = await new Promise((resolve, reject) => {
                            grecaptcha.ready(function() {
                                grecaptcha.execute('6LeE_RMtAAAAACe9qqdTi2iYcenZQEnH0-v5DZfk', {action: 'submit'})
                                    .then(function(t: string) {
                                        resolve(t);
                                    })
                                    .catch(function(err: any) {
                                        reject(err);
                                    });
                            });
                        });
                        formData.append('recaptcha_token', token as string);
                    } catch(error) {
                        console.log("reCAPTCHA skip due to invalid fake key, continuing...");
                    }
                }

                // Send to backend endpoint
                const response = await fetch('/api/contact', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();

                if (response.ok) {
                    form.innerHTML = `
                        <div style="text-align: center; padding: 2rem 0;">
                            <div style="width: 60px; height: 60px; background: #e0f2fe; color: #0284c7; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem auto;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            </div>
                            <h3 style="color: var(--primary-dark); margin-bottom: 1rem; font-size: 1.5rem;">¡Cotización Enviada!</h3>
                            <p style="color: var(--gray); font-size: 1.1rem; line-height: 1.5;">Revisa tu bandeja de entrada. Te hemos enviado un correo confirmando la recepción.</p>
                            <p style="color: var(--primary); font-weight: 500; margin-top: 1rem;">Te contactaremos en menos de 24 hrs.</p>
                        </div>
                    `;
                } else {
                    throw new Error(result.error || "Error desconocido");
                }

            } catch (error: any) {
                alert(error.message || "Hubo un error al enviar tu solicitud. Por favor intenta de nuevo o contáctanos por WhatsApp.");
                submitBtn.textContent = originalBtnText;
                submitBtn.disabled = false;
                submitBtn.style.opacity = "1";
            }
        });
    }
</script>
